@Host= http://localhost
@Port= 3000

@Server = {{Host}}:{{Port}}

### GET all tasks
GET {{Server}}/api/tasks
Content-Type: application/json

### GET task by id
GET {{Server}}/api/tasks/0
Content-Type: application/json

### POST a new task
POST {{Server}}/api/tasks
Content-Type: application/json

{
    "title": "New Task",
    "descriptions": "This is a new task",
    "deadline": "completed"
}

### UPDATE a task by id
PATCH  {{Server}}/api/tasks/0
Content-Type: application/json

{
    "title": "New Task",
    "descriptions": "This is a new task",
    "deadline": "completed",
    "completed": true
}

### DELETE task by id
DELETE {{Server}}/api/tasks/0
Content-Type: application/json

### DELETE all tasks
DELETE {{Server}}/api/tasks
Content-Type: application/json
